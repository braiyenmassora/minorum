# Site gate (login password). Localhost skips cookie gate, but login still checks this.
GATE_PASSWORD=change-me
# Signs the gate session cookie (HMAC). Required in production — any long random string.
GATE_SESSION_SECRET=

# Comma-separated production hostnames allowed past the gate (e.g. ai.example.com).
# Localhost/127.0.0.1/*.localhost always bypass this.
MINORUM_ALLOWED_HOSTS=

# API used after login (server-side). 9Router example — no trailing path needed (/v1 added automatically).
MINORUM_DEFAULT_API_URL=http://localhost:20128
MINORUM_DEFAULT_API_KEY=sk-your-key-here
# Optional. Prefer this model id when listed in /models (e.g. DealWithSign combo).
MINORUM_DEFAULT_MODEL=DealWithSign

# Optional web_search tools (Anthropic/OpenAI schema via 9Router). Off by default.
# MINORUM_WEB_TOOLS=1
# Comma-separated model allowlist; empty = all models when enabled.
# MINORUM_WEB_TOOLS_MODELS=kr/claude-sonnet-4.5,cc/claude-opus-4-6

# Models without a native browsing tool (e.g. DeepSeek, most non-Claude/OpenAI
# combos) fall back to 9Router's /v1/search + /v1/web/fetch instead. These pick
# which provider/combo id to call — see 9Router's /v1/models/web for options.
# MINORUM_SEARCH_PROVIDER=search-combo
# MINORUM_FETCH_PROVIDER=fetch-combo

# Neon/Postgres connection string for cross-device chat history (sessions/pin/search).
DATABASE_URL=
